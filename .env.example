# Banco de Dados (SQLite assíncrono padrão ou PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/dbname)
DATABASE_URL=sqlite+aiosqlite:///./data/houses.db

# Configurações do Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_EXAMPLE
TELEGRAM_CHAT_ID=-1001234567890

# URL de busca da OLX Brasil com os filtros de seu interesse
OLX_SEARCH_URL=https://www.olx.com.br/imoveis/aluguel/estado-pe/grande-recife/recife?pe=1800

# Intervalo de checagem do scraper em minutos
CHECK_INTERVAL_MINUTES=10

# Configurações do Servidor
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=False
ADMIN_SECRET_KEY=sua_chave_secreta_aqui

